{
  "name": "nissa-bookkeeping",
  "private": true,
  "version": "1.1.4",
  "author": "Apollodoras",
  "description": "Professional bookkeeping for Sole Proprietors & Service Businesses",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm run electron:build -- --watch\" \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 npm run electron\"",
    "build": "npm run electron:build && vite build && electron-builder",
    "build:win": "npm run electron:build && vite build && electron-builder --win",
    "electron": "electron .",
    "electron:build": "tsc -p electron/tsconfig.json",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.nissabookkeeping.app",
    "productName": "Nissa's Bookkeepin'",
    "copyright": "Copyright © 2026 Apollodoras",
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": null
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nissa's Bookkeepin'"
    }
  },
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "better-sqlite3": "^12.6.2",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.4.0",
    "electron-builder": "^26.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  }
}